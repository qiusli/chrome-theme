{
  "manifest_version": 3,
  "name": "Deep Green Ocean",
  "version": "1.0.6",
  "description": "A dark teal Chrome theme inspired by an underwater school of fish.",
  "icons": {
    "128": "images/icon-128.png"
  },
  "theme": {
    "images": {
      "theme_ntp_background": "images/ocean-background.png"
